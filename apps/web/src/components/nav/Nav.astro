---
// Top nav: logo, the Submit CTA, and the lazily-hydrated account slot. Menu
// links return in feature 14 once their destination pages exist.
import AccountMenu from './AccountMenu';
---

<header class="border-b border-border">
	<div class="mx-auto flex h-15 max-w-page items-center gap-5 px-6">
		<a href="/" class="flex items-center gap-[9px] font-semibold tracking-[-0.01em]">
			<img src="/logo-64.png" alt="" width="26" height="26" class="size-[26px]" />
			SkillPass
		</a>
		<nav class="ml-auto flex items-center gap-[22px] font-medium text-muted">
			<a
				href="/submit"
				class="inline-flex items-center gap-[7px] rounded-sm border border-border-2 px-3.5 py-2 text-[13px] font-semibold text-text hover:bg-hover"
			>
				Submit a skill
			</a>
			<AccountMenu client:idle />
		</nav>
	</div>
</header>
