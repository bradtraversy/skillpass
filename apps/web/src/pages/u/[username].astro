---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/nav/Nav.astro';
import Profile from '../../components/profile/Profile';

// Rendered on demand so a maintainer's profile exists as soon as they publish;
// the island fetches fresh data at runtime.
export const prerender = false;

const { username } = Astro.params;
if (!username) return new Response(null, { status: 404 });
---

<BaseLayout title={`${username} - Maintainer Profile`}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<a
			href="/"
			class="inline-flex items-center gap-[7px] pt-[26px] text-[13px] text-muted hover:text-text"
		>
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="m15 18-6-6 6-6"></path>
			</svg>
			Skills
		</a>
		<Profile client:load username={username} />
	</main>
</BaseLayout>
