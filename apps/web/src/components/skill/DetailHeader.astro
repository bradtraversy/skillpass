---
import type { Skill, Verdict } from '../../lib/skills';
import type { SkillDetail } from '../../lib/skill-details';
import { monogram, repoHandle } from '../../lib/format';
import { VERDICT_TINT } from '../../lib/verdict';

interface Props {
	skill: Skill;
	detail: SkillDetail;
}

const { skill, detail } = Astro.props;

const BIG_STAMP: Record<Verdict, { main: string; sub: string }> = {
	passed: { main: 'VERIFIED', sub: 'PASSED' },
	warning: { main: 'WARNING', sub: "REVIEW REQ'D" },
	failed: { main: 'FAILED', sub: 'BLOCKED' },
};
---

<div class="flex items-start gap-[18px] pt-5 pb-6">
	<div
		class="grid size-[52px] flex-none place-items-center rounded-[13px] border border-border-2 bg-surface-2 font-mono font-semibold text-accent"
	>
		{monogram(skill.name)}
	</div>

	<div class="min-w-0">
		<h1 class="text-[27px] font-[640] tracking-[-0.02em]">{skill.name}</h1>
		<p class="mt-[5px] text-[15px] text-muted">{skill.summary}</p>
		<div class="mt-3 flex flex-wrap items-center gap-3 text-[12.5px] text-muted">
			{
				skill.targets.map((target) => (
					<span class="rounded-[4px] border border-border px-[6px] py-px font-mono text-[10.5px] text-muted">
						{target}
					</span>
				))
			}
			<span class="inline-flex items-center gap-[6px]">
				<span aria-hidden="true">·</span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"
					></path>
				</svg>
				<a
					href={detail.githubRepoUrl}
					target="_blank"
					rel="noreferrer noopener"
					class="text-accent hover:underline">{repoHandle(detail.githubRepoUrl)}</a
				>
			</span>
		</div>
	</div>

	<div
		class:list={[
			'ml-auto flex flex-col items-center rounded-[8px] border-2 px-[14px] py-2 font-mono text-[15px] font-bold leading-[1.15] tracking-[0.12em] rotate-3 max-[620px]:hidden',
			VERDICT_TINT[skill.verdict].all,
		]}
	>
		{BIG_STAMP[skill.verdict].main}
		<small class="text-[8.5px] font-semibold tracking-[0.16em] opacity-80"
			>{BIG_STAMP[skill.verdict].sub}</small
		>
	</div>
</div>
