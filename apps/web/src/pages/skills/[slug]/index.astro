---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/nav/Nav.astro';
import SkillDetail from '../../../components/skill/SkillDetail';
import { API_URL } from '../../../lib/api';

// Build-time route discovery only; the island fetches fresh data at runtime.
// An unreachable API means no pre-built pages, never a failed build. In dev,
// Astro re-runs this per request, so new publishes get pages immediately.
export async function getStaticPaths() {
	try {
		const res = await fetch(`${API_URL}/skills`);
		const body = (await res.json()) as { success: boolean; data: { slug: string }[] };
		if (!body.success) throw new Error('skills list returned an error');
		return body.data.map((skill) => ({ params: { slug: skill.slug } }));
	} catch (err) {
		console.warn('getStaticPaths(/skills/[slug]): API unreachable, building no detail pages', err);
		return [];
	}
}

const { slug } = Astro.params;
---

<BaseLayout title={`${slug} - Skill Passport`}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<a
			href="/"
			class="inline-flex items-center gap-[7px] pt-[26px] text-[13px] text-muted hover:text-text"
		>
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="m15 18-6-6 6-6"></path>
			</svg>
			Skills
		</a>
		<SkillDetail client:load slug={slug} />
	</main>
</BaseLayout>
