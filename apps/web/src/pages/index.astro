---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/nav/Nav.astro';
import Hero from '../components/home/Hero.astro';
import Directory from '../components/home/Directory';
---

<BaseLayout
	title="SkillPass - AI Skills Directory"
	description="A validation-first directory of skills for AI coding agents. Every skill is inspected, permission-mapped, and stamped with a Skill Passport before you install it."
>
	<Nav />
	<main class="mx-auto max-w-page px-6">
		<Hero />
		<Directory client:visible />
	</main>
</BaseLayout>
