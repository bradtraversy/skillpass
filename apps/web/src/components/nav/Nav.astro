---
// Top nav: logo, docs links, the Submit CTA, and the lazily-hydrated account
// slot.
import AccountMenu from './AccountMenu';

const path = Astro.url.pathname.replace(/\/$/, '');
const cliActive = path === '/docs/cli';
const docsActive = path.startsWith('/docs') && !cliActive;
const link = (active: boolean) => `text-[13.5px] ${active ? 'text-text' : 'text-muted hover:text-text'}`;
---

<header class="border-b border-border">
	<div class="mx-auto flex h-15 max-w-page items-center gap-5 px-6">
		<a href="/" class="flex items-center gap-[9px] font-semibold tracking-[-0.01em]">
			<img src="/logo-64.png" alt="" width="28" height="28" class="size-[28px]" />
			SkillPass
		</a>
		<nav class="ml-auto flex items-center gap-[22px] font-medium text-muted">
			<a href="/docs" class={link(docsActive)}>
				Docs
			</a>
			<a href="/docs/cli" class={link(cliActive)}>
				CLI
			</a>
			<a
				href="/submit"
				class="inline-flex items-center gap-[7px] rounded-sm border border-border-2 px-3.5 py-2 text-[13px] font-semibold text-text hover:bg-hover"
			>
				Submit a skill
			</a>
			<AccountMenu client:idle />
		</nav>
	</div>
</header>
