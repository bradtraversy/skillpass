---
import type { FieldDoc } from '../../lib/api-docs';

interface Props {
	fields: FieldDoc[];
}

const { fields } = Astro.props;
---

<div class="overflow-x-auto">
	<table>
		<thead>
			<tr>
				<th>Field</th>
				<th>Type</th>
				<th>Meaning</th>
			</tr>
		</thead>
		<tbody>
			{fields.map((field) => (
				<tr>
					<td>
						<code>{field.name}</code>
					</td>
					<td>
						<code>{field.type}</code>
					</td>
					<td>{field.description}</td>
				</tr>
			))}
		</tbody>
	</table>
</div>
