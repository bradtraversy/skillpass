{
	"name": "apps-api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "node --env-file=.env --watch --import tsx src/index.ts",
		"dev:worker": "node --env-file=.env --watch --import tsx src/worker.ts",
		"start": "node --env-file=.env --import tsx src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
		"db:seed": "node --env-file-if-exists=.env --import tsx src/seed/run.ts",
		"db:backfill-descriptions": "node --env-file-if-exists=.env --import tsx src/seed/backfill-descriptions.ts",
		"db:backfill-ai-reviews": "node --env-file-if-exists=.env --import tsx src/seed/backfill-ai-reviews.ts",
		"db:backfill-categories": "node --env-file-if-exists=.env --import tsx src/seed/backfill-categories.ts",
		"db:backfill-display-copy": "node --env-file-if-exists=.env --import tsx src/seed/backfill-display-copy.ts",
		"db:backfill-integrations": "node --env-file-if-exists=.env --import tsx src/seed/backfill-integrations.ts",
		"db:backfill-embeddings": "node --env-file-if-exists=.env --import tsx src/seed/backfill-embeddings.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@hono/node-server": "^1.14.0",
		"@neondatabase/serverless": "^1.1.0",
		"aws4fetch": "^1.0.20",
		"bullmq": "^6.3.4",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"hono": "^4.7.0",
		"skill-schema": "workspace:*",
		"tar-stream": "^3.2.0",
		"tsx": "^4.19.0",
		"validator": "workspace:*",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/tar-stream": "^3.1.4",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3"
	}
}
