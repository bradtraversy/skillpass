---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackLink from '../../../components/nav/BackLink.astro';
import Nav from '../../../components/nav/Nav.astro';
import SkillDetail from '../../../components/skill/SkillDetail';
import { getSkill } from '../../../lib/api';
import { metaDescription } from '../../../lib/seo';
import { headFetch } from '../../../lib/ssr';

// Rendered on demand so a skill published after the last build has a page
// immediately; the island fetches fresh data at runtime. The head fetches the
// skill server-side so crawlers and unfurls see the real name and summary; on
// failure the page still renders with the slug-based title.
export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const skill = await headFetch(Astro.response, (init) => getSkill(slug, undefined, init));
const title = `${skill?.name ?? slug} - AI Agent Skill - SkillPass`;
const description = (skill && metaDescription(skill.summary)) || undefined;
---

<BaseLayout title={title} description={description}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<BackLink href="/">Skills</BackLink>
		<SkillDetail client:load slug={slug} />
	</main>
</BaseLayout>
