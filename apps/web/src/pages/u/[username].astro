---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/nav/BackLink.astro';
import Nav from '../../components/nav/Nav.astro';
import Profile from '../../components/profile/Profile';
import { getProfile } from '../../lib/api';
import { headFetch } from '../../lib/ssr';

// Rendered on demand so a maintainer's profile exists as soon as they publish;
// the island fetches fresh data at runtime. Head metadata is fetched
// server-side, falling back to the raw username.
export const prerender = false;

const { username } = Astro.params;
if (!username) return new Response(null, { status: 404 });

const profile = await headFetch(Astro.response, (init) => getProfile(username, init));
const title = `${profile?.displayName ?? username} - Skills on SkillPass`;
const description = profile
	? `AI agent skills maintained by ${profile.displayName} (@${profile.username}) on SkillPass, each validated and stamped with a Skill Passport.`
	: undefined;
---

<BaseLayout title={title} description={description}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<BackLink href="/">Skills</BackLink>
		<Profile client:load username={username} />
	</main>
</BaseLayout>
