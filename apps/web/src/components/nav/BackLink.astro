---
interface Props {
	href: string;
}
const { href } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-[7px] pt-[26px] text-[13px] text-muted hover:text-text">
	<svg
		width="15"
		height="15"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m15 18-6-6 6-6"></path>
	</svg>
	<slot />
</a>
