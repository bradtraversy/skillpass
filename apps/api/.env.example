# Neon Postgres connection string (Neon console -> your project -> Connect)
DATABASE_URL=postgres://user:password@host/dbname

# GitHub OAuth app (github.com -> Settings -> Developer settings -> OAuth Apps)
# Dev callback URL: http://localhost:8787/auth/github/callback
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Optional server-side PAT for submission lookups (raises GitHub's rate limit).
# Never a user's OAuth token. Fine to leave unset in dev.
# GITHUB_TOKEN=ghp_your-token

# Session cookie signing secret: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# Cloudflare R2 (dashboard -> R2 -> bucket -> API tokens; scope to this bucket).
# The bucket stays private - no public URL, ever.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=ai-skills-snapshots-dev

# Where the static site runs (OAuth redirects + CORS)
WEB_ORIGIN=http://localhost:4321

PORT=8787
