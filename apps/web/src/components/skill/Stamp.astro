---
import type { Verdict } from '../../lib/skills';
import { VERDICT_TINT } from '../../lib/verdict';

interface Props {
	verdict: Verdict;
}

const { verdict } = Astro.props;

const LABEL: Record<Verdict, string> = {
	passed: 'PASS',
	warning: 'WARN',
	failed: 'FAIL',
};
---

<span
	class:list={[
		'rounded-[5px] border px-[9px] py-1 font-mono text-[11px] font-bold tracking-[0.1em]',
		VERDICT_TINT[verdict].all,
	]}
>
	{LABEL[verdict]}
</span>
