---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/nav/Nav.astro';
import SkillDetail from '../../../components/skill/SkillDetail';

// Rendered on demand so a version permalink works the moment it publishes;
// the island fetches fresh data at runtime.
export const prerender = false;

const { slug, version } = Astro.params;
if (!slug || !version) return new Response(null, { status: 404 });
---

<BaseLayout title={`${slug} v${version} - Skill Passport`}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<a
			href={`/skills/${slug}`}
			class="inline-flex items-center gap-[7px] pt-[26px] text-[13px] text-muted hover:text-text"
		>
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="m15 18-6-6 6-6"></path>
			</svg>
			Latest version
		</a>
		<SkillDetail client:load slug={slug} version={version} />
	</main>
</BaseLayout>
