---
// Top nav: logo, docs links, the GitHub link, the Submit CTA, and the
// lazily-hydrated account slot.
import AccountMenu from './AccountMenu';

const path = Astro.url.pathname.replace(/\/$/, '');
const cliActive = path === '/docs/cli';
const docsActive = path.startsWith('/docs') && !cliActive;
const link = (active: boolean) => `text-[13.5px] ${active ? 'text-text' : 'text-muted hover:text-text'}`;
---

<header class="border-b border-border">
	<div class="mx-auto flex h-15 max-w-page items-center gap-5 px-6">
		<a href="/" class="flex items-center gap-[9px] font-semibold tracking-[-0.01em]">
			<img src="/logo-64.png" alt="" width="28" height="28" class="size-[28px]" />
			SkillPass
		</a>
		<nav class="ml-auto flex items-center gap-[22px] font-medium text-muted">
			<a href="/docs" class={link(docsActive)}>
				Docs
			</a>
			<a href="/docs/cli" class={link(cliActive)}>
				CLI
			</a>
			<a
				href="https://github.com/bradtraversy/skillpass"
				target="_blank"
				rel="noreferrer"
				aria-label="SkillPass on GitHub"
				class="text-muted hover:text-text"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
				</svg>
			</a>
			<a
				href="/submit"
				class="inline-flex items-center gap-[7px] rounded-sm border border-border-2 px-3.5 py-2 text-[13px] font-semibold text-text hover:bg-hover"
			>
				Submit a skill
			</a>
			<AccountMenu client:idle />
		</nav>
	</div>
</header>
