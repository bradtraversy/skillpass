---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackLink from '../../../components/nav/BackLink.astro';
import Nav from '../../../components/nav/Nav.astro';
import SkillDetail from '../../../components/skill/SkillDetail';
import { getSkill } from '../../../lib/api';
import { metaDescription } from '../../../lib/seo';
import { headFetch } from '../../../lib/ssr';

// Rendered on demand so a version permalink works the moment it publishes;
// the island fetches fresh data at runtime. Head metadata is fetched
// server-side; canonical points at the unversioned page so pinned permalinks
// don't compete with it in search.
export const prerender = false;

const { slug, version } = Astro.params;
if (!slug || !version) return new Response(null, { status: 404 });

const skill = await headFetch(Astro.response, (init) => getSkill(slug, version, init));
const title = `${skill?.name ?? slug} v${version} - SkillPass`;
const description = (skill && metaDescription(skill.summary)) || undefined;
---

<BaseLayout title={title} description={description} canonicalPath={`/skills/${slug}`}>
	<Nav />
	<main class="mx-auto max-w-[760px] px-6">
		<BackLink href={`/skills/${slug}`}>Latest version</BackLink>
		<SkillDetail client:load slug={slug} version={version} />
	</main>
</BaseLayout>
